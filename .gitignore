# Vendored SDKs shipped as archives. deps/BugSplat.xcframework.zip is already
# tracked -- it was force-added past the rule above, which left no trace of the
# intent -- so both are named here explicitly.
!deps/BugSplat.xcframework.zip
!deps/sentry-native.zip
*.lnk
*.chm
*~
.DS_Store
*/.DS_Store
*/**/.DS_Store

#claude code (settings.json, skills and hooks are shared; local overrides are not)
.claude/settings.local.json

#cmake/msbuild output from an in-tree build. leading slashes anchor these to the
#repo root so vendored project files under deps/ and CI/*/nsis/ stay tracked.
/ALL_BUILD.vcxproj*
/INSTALL.vcxproj*
/PACKAGE.vcxproj*
/obs-streamelements-core.sln
/obs-streamelements-core.vcxproj*
/obs-streamelements-core-streamelements-restore-script-host.vcxproj*
/cmake_install.cmake
/qrc_streamelements.cpp
/CMakeCache.txt
/CMakeFiles/
/RelWithDebInfo/
/*.dir/
/*_autogen/

#scratch dir the release workflows write recovered notes and changelogs into
/.release-input/

# Local, machine-specific agent notes (see CLAUDE.md)
CLAUDE.local.md

# MkDocs build output (see .github/workflows/pages.yml)
_site/
__pycache__/
*.pyc
